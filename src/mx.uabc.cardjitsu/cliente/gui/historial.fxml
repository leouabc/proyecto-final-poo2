<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="600.0" prefWidth="920.0" styleClass="historial-root" stylesheets="@historial.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cliente.gui.GameUI.HistorialController">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
    <top>
        <VBox spacing="8">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="HISTORIAL DE COMBATES" styleClass="historial-titulo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="REGRESAR" onAction="#onClickVolver" styleClass="historial-boton"/>
                </HBox>
                <Label fx:id="lblEstado" text="Consultando historial..." styleClass="historial-estado"/>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tvHistorial" styleClass="historial-tabla">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="145"/>
                <TableColumn fx:id="colRival" text="Rival" prefWidth="150"/>
                <TableColumn fx:id="colResultado" text="Resultado" prefWidth="110"/>
                <TableColumn fx:id="colRondas" text="Rondas" prefWidth="90"/>
                <TableColumn fx:id="colMotivo" text="Finalización" prefWidth="220"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
